# Copiar como .env y completar solo los secretos necesarios.
MNQ_CONFIG=config.example.yaml
# Debe ser >= 30 segundos.
MNQ_POLL_SECONDS=300
MNQ_ALERT_MIN_INTERVAL=60
# Vacío = log JSON local; con URL = POST de alertas LONG/SHORT. NO_TRADE nunca se envía.
MNQ_WEBHOOK_URL=
PORT=8080
# Necesaria únicamente cuando data.source=databento.
DATABENTO_API_KEY=
